generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum OrderStatus {
  RECEIVED
  PREPARING
  ON_ROUTE
  DELIVERED
}

enum StopAccess {
  CAR_ONLY
  MOTORCYCLE_ONLY
  BOTH
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  ADMIN
  OPS_MANAGER
  DRIVER
  WAREHOUSE
}

enum FulfillmentStatus {
  NOT_STARTED
  PICKING
  PACKED
  READY_FOR_DISPATCH
  LOADED
  EXCEPTION
}

enum IntegrationRunKind {
  OMS_ORDERS
  WMS_FULFILLMENT
  INTELLIGENCE
}

enum IntegrationRunStatus {
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum ControlTowerExceptionKind {
  UNASSIGNED_ORDER
  SLA_RISK
  LATE_STOP
  FULFILLMENT_BLOCKED
  FLEET_RISK
  CONGESTION_RISK
  WEATHER_RISK
  INCIDENT_NEAR_ROUTE
  STALE_TRAFFIC
  STALE_WEATHER
  BARCODE_MISMATCH
}

enum ControlTowerSeverity {
  WATCH
  HIGH
  CRITICAL
}

enum ControlTowerExceptionStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
}

enum RouteRevisionStatus {
  DRAFT
  APPROVED
  REJECTED
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  name                    String
  passwordHash            String
  role                    UserRole
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  acknowledgedExceptions  ControlTowerException[]  @relation("ExceptionAcknowledgedBy")
  resolvedExceptions      ControlTowerException[]  @relation("ExceptionResolvedBy")
  auditEvents             AuditEvent[]
  parcelVerificationScans ParcelVerificationScan[]
}

model Vehicle {
  id                     String                  @id @default(cuid())
  name                   String
  vehicleType            String
  engineType             String
  vehicleAgeYears        Float
  odometerKm             Float
  kilometersPerFleet     Float
  vehicleLifetimeYears   Float
  expectedLifetimeKm     Float
  maintenanceCostUnit    Float
  lastMaintenanceDate    DateTime?
  nextMaintenanceDate    DateTime?
  maintenanceIntervalKm  Float
  notes                  String?
  dataSource             String                  @default("manual")
  connectorId            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  connector              DataConnector?          @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  drivers                Driver[]
  controlTowerExceptions ControlTowerException[]
}

model DataConnector {
  id              String           @id @default(cuid())
  name            String
  type            String
  status          String           @default("disabled")
  config          String?
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  vehicles        Vehicle[]
  integrationRuns IntegrationRun[]
  auditEvents     AuditEvent[]
}

model IntelligenceRegion {
  id          String   @id @default(cuid())
  name        String
  countryCode String
  timezone    String   @default("Asia/Jakarta")
  minLat      Float
  minLng      Float
  maxLat      Float
  maxLng      Float
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  config             IntelligenceConfig?
  ingestionRuns      IntelligenceIngestionRun[]
  conditionSnapshots ConditionSnapshot[]
  incidents          TrafficIncident[]
  routeObservations  RouteConditionObservation[]
  auditEvents        AuditEvent[]

  @@index([active])
}

model IntelligenceConfig {
  id                   String             @id @default(cuid())
  regionId             String             @unique
  region               IntelligenceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  enabled              Boolean            @default(true)
  refreshIntervalSec   Int                @default(300)
  providerPriorityJson String             @default("[\"google\",\"open_meteo\",\"tomtom\"]")
  thresholdsJson       String             @default("{}")
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model IntelligenceIngestionRun {
  id            String             @id @default(cuid())
  regionId      String
  region        IntelligenceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  mode          String
  status        String
  startedAt     DateTime           @default(now())
  completedAt   DateTime?
  providersJson String
  snapshotCount Int                @default(0)
  incidentCount Int                @default(0)
  errorJson     String?
  auditEvents   AuditEvent[]

  @@index([regionId, startedAt])
}

model Warehouse {
  id         String      @id @default(cuid())
  name       String
  address    String?
  lat        Float
  lng        Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  routePlans RoutePlan[]
}

model Driver {
  id            String      @id @default(cuid())
  name          String
  phone         String?
  employeeId    String?
  licenseNumber String?
  status        String      @default("available")
  vehicleId     String
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  routePlans    RoutePlan[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  recipientAddress  String
  lat               Float
  lng               Float
  accessRequirement StopAccess  @default(BOTH)
  status            OrderStatus @default(RECEIVED)

  receivedAt  DateTime?
  preparingAt DateTime?
  onRouteAt   DateTime?
  etaAt       DateTime?
  deliveredAt DateTime?

  externalOrderId   String?
  sourceSystem      String            @default("manual")
  promisedAt        DateTime?
  serviceLevel      String?
  priority          String?
  fulfillmentStatus FulfillmentStatus @default(NOT_STARTED)

  routePlanId String?
  routePlan   RoutePlan? @relation(fields: [routePlanId], references: [id], onDelete: SetNull)

  statusEvents            OrderStatusEvent[]
  fulfillmentEvents       FulfillmentEvent[]
  controlTowerExceptions  ControlTowerException[]
  reconciliationIssues    ReconciliationIssue[]
  parcelVerificationScans ParcelVerificationScan[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  routeStop RouteStop?

  @@unique([sourceSystem, externalOrderId])
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  timestamp DateTime    @default(now())

  @@index([orderId])
}

model FulfillmentEvent {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sourceSystem    String
  externalEventId String?
  status          FulfillmentStatus
  occurredAt      DateTime
  receivedAt      DateTime          @default(now())
  reason          String?
  payloadJson     String?

  @@unique([sourceSystem, externalEventId])
  @@index([orderId, occurredAt])
}

model RoutePlan {
  id String @id @default(cuid())

  status       RouteStatus @default(PLANNED)
  routeStartAt DateTime?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  totalDistanceKm      Float @default(0)
  totalDurationMin     Float @default(0)
  estimatedEmissionsKg Float @default(0)

  stops  RouteStop[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  controlTowerExceptions  ControlTowerException[]
  conditionAssessments    RouteConditionAssessment[]
  revisionPreviews        RouteRevision[]
  conditionObservations   RouteConditionObservation[]
  auditEvents             AuditEvent[]
  parcelVerificationScans ParcelVerificationScan[]

  @@index([driverId])
  @@index([warehouseId])
}

model ConditionSnapshot {
  id                     String             @id @default(cuid())
  regionId               String
  region                 IntelligenceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  dataType               String
  observedAt             DateTime
  expiresAt              DateTime
  source                 String
  trafficLevel           String?
  congestionRatio        Float?
  precipitationMmPerHour Float?
  visibilityMeters       Float?
  windKmh                Float?
  incidentCount          Int?
  stale                  Boolean            @default(false)
  payloadJson            String?
  createdAt              DateTime           @default(now())

  routeObservations RouteConditionObservation[]
  auditEvents       AuditEvent[]

  @@unique([regionId, source, dataType, observedAt])
  @@index([regionId, observedAt])
  @@index([expiresAt, stale])
}

model TrafficIncident {
  id          String             @id @default(cuid())
  regionId    String
  region      IntelligenceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  externalId  String
  source      String
  observedAt  DateTime
  expiresAt   DateTime?
  category    String
  severity    String
  lat         Float
  lng         Float
  description String?
  roadClosed  Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  auditEvents AuditEvent[]

  @@unique([source, externalId])
  @@index([regionId, observedAt])
  @@index([lat, lng])
}

model RouteConditionAssessment {
  id                    String       @id @default(cuid())
  routePlanId           String
  routePlan             RoutePlan    @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  riskLevel             String
  trafficPenaltyFactor  Float        @default(1)
  weatherPenaltyFactor  Float        @default(1)
  incidentPenaltyFactor Float        @default(1)
  reasonsJson           String
  snapshotIdsJson       String
  assessedAt            DateTime     @default(now())
  auditEvents           AuditEvent[]

  @@index([routePlanId, assessedAt])
}

model RouteRevision {
  id                  String              @id @default(cuid())
  routePlanId         String
  routePlan           RoutePlan           @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  status              RouteRevisionStatus @default(DRAFT)
  originalDurationMin Float
  revisedDurationMin  Float
  originalDistanceKm  Float
  revisedDistanceKm   Float
  affectedStops       Int                 @default(0)
  reasonsJson         String
  previewJson         String
  createdByUserId     String?
  approvedByUserId    String?
  rejectedByUserId    String?
  createdAt           DateTime            @default(now())
  approvedAt          DateTime?
  rejectedAt          DateTime?
  scenarioKey         String?
  auditEvents         AuditEvent[]

  @@index([routePlanId, status])
  @@index([scenarioKey, createdAt])
}

model RouteStop {
  id String @id @default(cuid())

  routePlanId String
  routePlan   RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sequence    Int
  etaAt       DateTime?
  distanceKm  Float
  durationMin Float

  createdAt             DateTime                    @default(now())
  updatedAt             DateTime                    @updatedAt
  conditionObservations RouteConditionObservation[]

  @@unique([routePlanId, sequence])
  @@index([routePlanId])
}

model FuelPriceSnapshot {
  id             String          @id @default(cuid())
  region         String
  effectiveLabel String?
  sourceUrl      String
  fetchMethod    String          @default("pertamina_fallback")
  fetchedAt      DateTime        @default(now())
  items          FuelPriceItem[]

  @@index([fetchedAt])
}

model FuelPriceItem {
  id            String            @id @default(cuid())
  snapshotId    String
  snapshot      FuelPriceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productCode   String
  productName   String
  pricePerLiter Float
  subsidy       Boolean           @default(false)
  engineTypes   String
  vehicleTypes  String

  @@unique([snapshotId, productCode])
  @@index([snapshotId])
}

/// Singleton row (id = "default") for site-wide OpenAI-compatible AI provider settings.
model AiProviderConfig {
  id        String   @id @default("default")
  apiKey    String
  baseUrl   String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Saved Flo Designer canvas (ADMIN CRUD). Graph is stored as JSON text,
/// including optional per-node `_floId` annotations and FLO integration edges.
model DesignerDesign {
  id        String   @id @default(cuid())
  name      String
  graphJson String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model IntegrationRun {
  id                   String                @id @default(cuid())
  connectorId          String
  connector            DataConnector         @relation(fields: [connectorId], references: [id], onDelete: Cascade)
  kind                 IntegrationRunKind
  mode                 String                @default("fixture")
  status               IntegrationRunStatus  @default(RUNNING)
  startedAt            DateTime              @default(now())
  completedAt          DateTime?
  createdCount         Int                   @default(0)
  updatedCount         Int                   @default(0)
  rejectedCount        Int                   @default(0)
  errorsJson           String?
  reconciliationIssues ReconciliationIssue[]
  auditEvents          AuditEvent[]

  @@index([connectorId, startedAt])
}

model ControlTowerException {
  id                   String                      @id @default(cuid())
  kind                 ControlTowerExceptionKind
  severity             ControlTowerSeverity
  status               ControlTowerExceptionStatus @default(OPEN)
  dedupeKey            String                      @unique
  sourceSystem         String?
  reason               String
  resolutionNote       String?
  detectedAt           DateTime                    @default(now())
  acknowledgedAt       DateTime?
  resolvedAt           DateTime?
  acknowledgedByUserId String?
  acknowledgedBy       User?                       @relation("ExceptionAcknowledgedBy", fields: [acknowledgedByUserId], references: [id], onDelete: SetNull)
  resolvedByUserId     String?
  resolvedBy           User?                       @relation("ExceptionResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  orderId              String?
  order                Order?                      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  routePlanId          String?
  routePlan            RoutePlan?                  @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  vehicleId            String?
  vehicle              Vehicle?                    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  updatedAt            DateTime                    @updatedAt
  auditEvents          AuditEvent[]

  @@index([status, severity])
  @@index([orderId])
  @@index([routePlanId])
}

model ParcelVerificationScan {
  id          String     @id @default(cuid())
  code        String
  format      String     @default("BARCODE")
  outcome     String
  source      String
  message     String
  checksJson  String
  fixtureId   String?
  orderId     String?
  order       Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull)
  routePlanId String?
  routePlan   RoutePlan? @relation(fields: [routePlanId], references: [id], onDelete: SetNull)
  actorUserId String?
  actorUser   User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@index([code, createdAt])
  @@index([outcome, createdAt])
  @@index([orderId])
}

model DemoScenarioRun {
  id                  String    @id
  scenarioKey         String
  status              String    @default("IDLE")
  step                Int       @default(0)
  synthetic           Boolean   @default(true)
  baselineRoutePlanId String?
  baselineJson        String?
  startedAt           DateTime?
  completedAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([scenarioKey, status])
  @@index([updatedAt])
}

model RouteConditionObservation {
  id                String             @id @default(cuid())
  routePlanId       String
  routePlan         RoutePlan          @relation(fields: [routePlanId], references: [id], onDelete: Cascade)
  routeStopId       String?
  routeStop         RouteStop?         @relation(fields: [routeStopId], references: [id], onDelete: Cascade)
  snapshotId        String
  snapshot          ConditionSnapshot  @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  regionId          String
  region            IntelligenceRegion @relation(fields: [regionId], references: [id], onDelete: Cascade)
  distanceToRouteKm Float
  affected          Boolean            @default(false)
  relevanceScore    Float              @default(0)
  createdAt         DateTime           @default(now())

  @@unique([routePlanId, snapshotId, routeStopId])
  @@index([routePlanId, affected])
  @@index([regionId, createdAt])
}

model ReconciliationIssue {
  id               String          @id @default(cuid())
  issueType        String
  status           String          @default("OPEN")
  orderId          String?
  order            Order?          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  integrationRunId String?
  integrationRun   IntegrationRun? @relation(fields: [integrationRunId], references: [id], onDelete: SetNull)
  externalOrderId  String
  omsStatus        String?
  wmsStatus        String?
  detailsJson      String
  firstDetectedAt  DateTime        @default(now())
  lastDetectedAt   DateTime        @default(now())
  resolutionNote   String?
  resolvedByUserId String?
  resolvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([issueType, externalOrderId, status])
  @@index([status, issueType])
  @@index([externalOrderId])
}

model AuditEvent {
  id                    String                    @id @default(cuid())
  eventType             String
  action                String
  summary               String
  reason                String?
  actorUserId           String?
  actorRole             String?
  entityType            String
  entityId              String
  beforeJson            String?
  afterJson             String?
  metadataJson          String?
  sourceSystem          String?
  provider              String?
  regionId              String?
  region                IntelligenceRegion?       @relation(fields: [regionId], references: [id], onDelete: SetNull)
  user                  User?                     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  routePlanId           String?
  routePlan             RoutePlan?                @relation(fields: [routePlanId], references: [id], onDelete: SetNull)
  routeRevisionId       String?
  routeRevision         RouteRevision?            @relation(fields: [routeRevisionId], references: [id], onDelete: SetNull)
  exceptionId           String?
  exception             ControlTowerException?    @relation(fields: [exceptionId], references: [id], onDelete: SetNull)
  snapshotId            String?
  snapshot              ConditionSnapshot?        @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  ingestionRunId        String?
  ingestionRun          IntelligenceIngestionRun? @relation(fields: [ingestionRunId], references: [id], onDelete: SetNull)
  integrationRunId      String?
  integrationRun        IntegrationRun?           @relation(fields: [integrationRunId], references: [id], onDelete: SetNull)
  connectorId           String?
  connector             DataConnector?            @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  conditionAssessmentId String?
  conditionAssessment   RouteConditionAssessment? @relation(fields: [conditionAssessmentId], references: [id], onDelete: SetNull)
  trafficIncidentId     String?
  trafficIncident       TrafficIncident?          @relation(fields: [trafficIncidentId], references: [id], onDelete: SetNull)
  createdAt             DateTime                  @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([eventType, createdAt])
  @@index([actorUserId, createdAt])
  @@index([regionId, createdAt])
}
