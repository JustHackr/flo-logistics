generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum OrderStatus {
  RECEIVED
  PREPARING
  ON_ROUTE
  DELIVERED
}

enum StopAccess {
  CAR_ONLY
  MOTORCYCLE_ONLY
  BOTH
}

enum RouteStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
}

enum UserRole {
  ADMIN
  OPS_MANAGER
  DRIVER
  WAREHOUSE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Vehicle {
  id                    String         @id @default(cuid())
  name                  String
  vehicleType           String
  engineType            String
  vehicleAgeYears       Float
  odometerKm            Float
  kilometersPerFleet    Float
  vehicleLifetimeYears  Float
  expectedLifetimeKm    Float
  maintenanceCostUnit   Float
  lastMaintenanceDate   DateTime?
  nextMaintenanceDate   DateTime?
  maintenanceIntervalKm Float
  notes                 String?
  dataSource            String         @default("manual")
  connectorId           String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  connector             DataConnector? @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  drivers               Driver[]
}

model DataConnector {
  id          String    @id @default(cuid())
  name        String
  type        String
  status      String    @default("disabled")
  config      String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vehicles    Vehicle[]
}

model Warehouse {
  id         String      @id @default(cuid())
  name       String
  address    String?
  lat        Float
  lng        Float
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  routePlans RoutePlan[]
}

model Driver {
  id            String      @id @default(cuid())
  name          String
  phone         String?
  employeeId    String?
  licenseNumber String?
  status        String      @default("available")
  vehicleId     String
  vehicle       Vehicle     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  routePlans    RoutePlan[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model Order {
  id                String      @id @default(cuid())
  recipientAddress  String
  lat               Float
  lng               Float
  accessRequirement StopAccess  @default(BOTH)
  status            OrderStatus @default(RECEIVED)

  receivedAt  DateTime?
  preparingAt DateTime?
  onRouteAt   DateTime?
  etaAt       DateTime?
  deliveredAt DateTime?

  routePlanId String?
  routePlan   RoutePlan? @relation(fields: [routePlanId], references: [id], onDelete: SetNull)

  statusEvents OrderStatusEvent[]

  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  routeStop RouteStop?
}

model OrderStatusEvent {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  timestamp DateTime    @default(now())

  @@index([orderId])
}

model RoutePlan {
  id String @id @default(cuid())

  status       RouteStatus @default(PLANNED)
  routeStartAt DateTime?

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  driverId String
  driver   Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  totalDistanceKm      Float @default(0)
  totalDurationMin     Float @default(0)
  estimatedEmissionsKg Float @default(0)

  stops  RouteStop[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([driverId])
  @@index([warehouseId])
}

model RouteStop {
  id String @id @default(cuid())

  routePlanId String
  routePlan   RoutePlan @relation(fields: [routePlanId], references: [id], onDelete: Cascade)

  orderId String @unique
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  sequence    Int
  etaAt       DateTime?
  distanceKm  Float
  durationMin Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([routePlanId, sequence])
  @@index([routePlanId])
}

model FuelPriceSnapshot {
  id             String          @id @default(cuid())
  region         String
  effectiveLabel String?
  sourceUrl      String
  fetchMethod    String          @default("pertamina_fallback")
  fetchedAt      DateTime        @default(now())
  items          FuelPriceItem[]

  @@index([fetchedAt])
}

model FuelPriceItem {
  id            String            @id @default(cuid())
  snapshotId    String
  snapshot      FuelPriceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  productCode   String
  productName   String
  pricePerLiter Float
  subsidy       Boolean           @default(false)
  engineTypes   String
  vehicleTypes  String

  @@unique([snapshotId, productCode])
  @@index([snapshotId])
}

/// Singleton row (id = "default") for site-wide OpenAI-compatible AI provider settings.
model AiProviderConfig {
  id        String   @id @default("default")
  apiKey    String
  baseUrl   String
  model     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
