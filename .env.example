# Optional: upgrade routing from OSRM to Google live traffic (server-side only)
GOOGLE_MAPS_API_KEY=
GOOGLE_DISTANCE_MATRIX_API_KEY=

# Optional: Maps JavaScript key (referrer-restricted). Falls back to GOOGLE_MAPS_API_KEY.
GOOGLE_MAPS_JS_API_KEY=

# --- Sovereign AI (default) ---
# The Company Assistant answers from live SQLite via the in-process helper.
# No outbound LLM calls unless an ADMIN saves Ollama / OpenAI-compatible
# settings in /ai/settings (SQLite), or all of the following env bootstrap vars
# are set (used only when no outbound SQLite config exists):

# Opt-in env bootstrap (OpenAI-compatible). Prefer AI Settings UI after first run.
# AI_ALLOW_EXTERNAL=true
# AI_API_KEY=
# AI_BASE_URL=https://your-openai-compatible-host/v1
# AI_MODEL=your-model-id

# Ollama example (usually configured in AI Settings, not env):
# AI_ALLOW_EXTERNAL=true
# AI_API_KEY=ollama
# AI_BASE_URL=http://127.0.0.1:11434/v1
# AI_MODEL=llama3.2

# Seed controls (used by `npm run db:seed` / production build):
# SKIP_SEED=true          # never wipe/reseed
# FORCE_SEED=true         # reseed even if routes were updated in the last hour

# Subpath deploy (VPS demo):
# NEXT_BASE_PATH=/flo-logistics/demo

# Session signing key for the demo /login (HMAC-SHA256). Used to mint and verify
# the `flo_session` cookie. If unset, the app falls back to a dev-only secret
# and warns — set a long random string in production.
# FLO_SESSION_SECRET=please-replace-with-32-byte-random-value

# Laptop install wizard: npm run install:flo
