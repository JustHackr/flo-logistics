[Unit]
Description=Quasarian FLO logistics (Next.js)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/flo-logistics-src
EnvironmentFile=-/etc/flo-logistics/demo.env
Environment=NODE_ENV=production
Environment=PORT=3011
Environment=NEXT_BASE_PATH=/flo-logistics/demo
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 3011
Restart=on-failure
RestartSec=5
MemoryMax=768M

[Install]
WantedBy=multi-user.target
